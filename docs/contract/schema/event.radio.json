{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/event.radio.json",
  "title": "Data of a radio event (TELEMETRY.md section 3)",
  "type": "object",
  "required": [
    "rx",
    "tx",
    "queue_full",
    "cad_timeout",
    "startrx_timeout",
    "noise_floor_dbm",
    "last",
    "airtime",
    "duty",
    "queue_full_count",
    "cad_busy_retries",
    "duty_holds",
    "queue"
  ],
  "properties": {
    "rx": {
      "type": "object",
      "required": [
        "flood",
        "direct",
        "dup",
        "dropped",
        "unparsable"
      ],
      "properties": {
        "flood": {
          "type": "integer",
          "minimum": 0
        },
        "direct": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "dup": {
          "type": "integer",
          "minimum": 0,
          "description": "packets whose hash had been seen before"
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "description": "direct packets that reached this node but name another node as the next hop"
        },
        "unparsable": {
          "type": "integer",
          "minimum": 0,
          "description": "frames received that were not a valid packet (bad version, reserved path mode, truncated or oversize)"
        }
      }
    },
    "tx": {
      "type": "object",
      "required": [
        "flood",
        "direct",
        "failed"
      ],
      "properties": {
        "flood": {
          "type": "integer",
          "minimum": 0
        },
        "direct": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "packets dropped because the send failed to start, timed out, or could never fit the duty limit"
        }
      }
    },
    "queue_full": {
      "type": "boolean"
    },
    "cad_timeout": {
      "type": "boolean"
    },
    "startrx_timeout": {
      "type": "boolean"
    },
    "noise_floor_dbm": {
      "type": [
        "integer",
        "null"
      ],
      "description": "null until the driver has calibrated"
    },
    "last": {
      "type": "object",
      "required": [
        "rssi_dbm",
        "snr_db"
      ],
      "properties": {
        "rssi_dbm": {
          "type": [
            "integer",
            "null"
          ]
        },
        "snr_db": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "airtime": {
      "type": "object",
      "required": [
        "tx_ms",
        "rx_ms"
      ],
      "properties": {
        "tx_ms": {
          "type": "integer",
          "minimum": 0
        },
        "rx_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "duty": {
      "type": "object",
      "required": [
        "limit_bp",
        "limit_ms",
        "used_ms"
      ],
      "properties": {
        "limit_bp": {
          "type": "integer",
          "minimum": 0
        },
        "limit_ms": {
          "type": "integer",
          "minimum": 0
        },
        "used_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "queue_full_count": {
      "type": "integer",
      "minimum": 0,
      "description": "times no packet was free to receive into or to build; queue_full says only that it happened since the last clear"
    },
    "cad_busy_retries": {
      "type": "integer",
      "minimum": 0,
      "description": "sends put off because the channel was busy"
    },
    "duty_holds": {
      "type": "integer",
      "minimum": 0,
      "description": "sends put back to wait for airtime"
    },
    "queue": {
      "type": "object",
      "required": [
        "depth",
        "free"
      ],
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 0,
          "description": "packets waiting to send, including those waiting for their time"
        },
        "free": {
          "type": "integer",
          "minimum": 0,
          "description": "unused packets left in the pool"
        }
      }
    }
  }
}
