{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/scope.default.set.result.json",
  "title": "Result of scope.default.set",
  "description": "The scope set; a change by a caller other than the unsigned cable also carries job, job_state and confirm_left_s, or reverted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31
    },
    "kind": {
      "enum": [
        "hashtag",
        "private"
      ]
    },
    "job": {
      "type": "string"
    },
    "job_state": {
      "enum": [
        "awaiting-confirm",
        "failed"
      ]
    },
    "confirm_left_s": {
      "type": "integer",
      "minimum": 30,
      "maximum": 900
    },
    "reverted": {
      "type": "boolean"
    }
  }
}
