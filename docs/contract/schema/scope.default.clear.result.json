{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/scope.default.clear.result.json",
  "title": "Result of scope.default.clear",
  "description": "Empty, or the job fields of a change that must be confirmed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job": {
      "type": "string"
    },
    "job_state": {
      "enum": [
        "awaiting-confirm",
        "failed"
      ]
    },
    "confirm_left_s": {
      "type": "integer",
      "minimum": 30,
      "maximum": 900
    },
    "reverted": {
      "type": "boolean"
    }
  }
}
