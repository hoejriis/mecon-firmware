{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/hello.result.json",
  "title": "Result of hello (v1.0)",
  "type": "object",
  "required": ["interface", "device_id", "node_key", "role", "hardware", "firmware", "upstream", "epoch", "capabilities"],
  "properties": {
    "interface": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "device_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "node_key": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The native MeshCore public key."},
    "role": {"type": "string", "enum": ["companion", "repeater", "room", "sensor"]},
    "hardware": {"type": "string"},
    "firmware": {"type": "string", "description": "mecon-firmware version, for example v1.18.0-mecon.0.1.3."},
    "upstream": {"type": "string", "description": "The MeshCore release it is built on, for example v1.18.0."},
    "epoch": {"type": "integer", "minimum": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "contains": {"const": "hello"}}
  }
}
