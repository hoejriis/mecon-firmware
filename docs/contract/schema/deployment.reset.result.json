{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/deployment.reset.result.json",
  "title": "Result of deployment.reset",
  "description": "AUTHORITY.md section 11: what went, of the record, the marks, the unlock secret, the continuity package and the marker, and what stays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "removed",
    "kept"
  ],
  "properties": {
    "state": {
      "const": "none"
    },
    "removed": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "enum": [
          "record",
          "marks",
          "unlock_secret",
          "marker",
          "continuity"
        ]
      }
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
