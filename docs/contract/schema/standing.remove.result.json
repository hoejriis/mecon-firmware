{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/standing.remove.result.json",
  "title": "Result of standing.remove",
  "type": "object",
  "required": [
    "id",
    "removed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[0-9A-Za-z._:-]+$"
    },
    "removed": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": false
}
