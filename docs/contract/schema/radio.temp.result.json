{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/radio.temp.result.json",
  "title": "Result of radio.temp: the temporary radio and how long it holds",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "radio",
    "minutes"
  ],
  "properties": {
    "radio": {
      "type": "string"
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    }
  }
}
