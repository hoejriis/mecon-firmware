{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/event.runtime.json",
  "title": "Data of a runtime event (TELEMETRY.md section 3)",
  "type": "object",
  "required": [
    "reset_reason",
    "abnormal_reset",
    "boot_ms",
    "loop_gap_ms"
  ],
  "properties": {
    "reset_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "abnormal_reset": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "boot_ms": {
      "type": "object",
      "required": [
        "store",
        "mesh",
        "setup"
      ],
      "properties": {
        "store": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mesh": {
          "type": [
            "integer",
            "null"
          ]
        },
        "setup": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "loop_gap_ms": {
      "type": "object",
      "required": [
        "max"
      ],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "description": "the longest main-loop pass since the previous runtime event, ms; 0 before two passes"
        }
      }
    }
  }
}
