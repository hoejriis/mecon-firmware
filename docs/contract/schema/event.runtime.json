{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/event.runtime.json",
  "title": "Data of a runtime event (TELEMETRY.md section 3)",
  "type": "object",
  "required": [
    "reset_reason"
  ],
  "properties": {
    "reset_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "abnormal_reset": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "boot_ms": {
      "type": "object",
      "required": [
        "store",
        "mesh",
        "setup"
      ],
      "properties": {
        "store": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mesh": {
          "type": [
            "integer",
            "null"
          ]
        },
        "setup": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "loop_gap_ms": {
      "type": "object",
      "required": [
        "max"
      ],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "description": "the longest main-loop pass since the previous runtime event, ms; 0 before two passes"
        }
      }
    },
    "boot": {
      "const": true,
      "description": "present, and true, only on the boot event"
    },
    "firmware": {
      "type": "string",
      "description": "boot event only: as hello"
    },
    "upstream": {
      "type": "string",
      "description": "boot event only: as hello"
    },
    "hardware": {
      "type": "string",
      "description": "boot event only: as hello"
    },
    "role": {
      "enum": [
        "companion",
        "repeater",
        "room"
      ],
      "description": "boot event only: as hello"
    },
    "heap_low": {
      "type": "boolean",
      "description": "the low-memory state the Companion's display shows (HeapFloor); absent where the build does not check the heap floor"
    },
    "heap_lows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "largest",
        "min_free"
      ],
      "description": "beside heap_low, what was running when each figure was at its lowest since boot (HeapWatch); null until the first look",
      "properties": {
        "largest": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "bytes",
            "by",
            "at_s"
          ],
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "by": {
              "type": "string",
              "description": "what was running: an operation's name, request, stream.<name>, mqtt.connect, mqtt.request, mqtt.publish, or idle"
            },
            "at_s": {
              "type": "integer",
              "minimum": 0,
              "description": "seconds since boot"
            }
          }
        },
        "min_free": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "bytes",
            "by",
            "at_s"
          ],
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "by": {
              "type": "string",
              "description": "what was running: an operation's name, request, stream.<name>, mqtt.connect, mqtt.request, mqtt.publish, or idle"
            },
            "at_s": {
              "type": "integer",
              "minimum": 0,
              "description": "seconds since boot"
            }
          }
        }
      }
    },
    "stale_logins": {
      "type": "integer",
      "minimum": 0,
      "description": "Repeater and Room server: remote logins refused as stale since boot; absent on the Companion"
    },
    "stale_login_last": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}$",
      "description": "Repeater and Room server: the 4-byte key prefix of the last client refused as stale, as hex; null before the first refusal"
    },
    "gnss": {
      "type": "object",
      "description": "Present only on a board with a GNSS receiver (TELEMETRY.md).",
      "properties": {
        "powered": {
          "type": "boolean"
        },
        "fix": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sats": {
          "type": "integer",
          "minimum": 0
        },
        "fix_age_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "powered",
        "fix",
        "sats",
        "fix_age_s"
      ]
    }
  },
  "description": "Two shapes. A snapshot (periodic, and at once when a subscription starts) has reset_reason, abnormal_reset, boot_ms, loop_gap_ms and, on the Companion, heap_low, or on the Repeater and Room server, stale_logins and stale_login_last. The boot event is sent once per epoch right after the first snapshot: boot is true and it carries firmware, upstream, hardware and role as hello does, and reset_reason; it has none of the snapshot-only members."
}
