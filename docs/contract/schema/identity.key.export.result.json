{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/identity.key.export.result.json",
  "title": "Result of identity.key.export",
  "description": "Either the node private key in clear (key: 128 hex digits, MeshCore's 64-byte form), on a device with no Deployment record or a corrupt one; or, once enrolled, the key wrapped for the member that signed the request (wrapped: base64 of mecon-kx-v1, ciphertext then a 16-byte tag; for: that member's instance_id; alg: mecon-kx-v1). Never both.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapped",
        "for",
        "alg"
      ],
      "properties": {
        "wrapped": {
          "type": "string",
          "minLength": 108,
          "maxLength": 108
        },
        "for": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32
        },
        "alg": {
          "type": "string",
          "enum": [
            "mecon-kx-v1"
          ]
        }
      }
    }
  ]
}
