{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/deployment.continuity.export.result.json",
  "title": "Result of deployment.continuity.export",
  "description": "AUTHORITY.md section 10a: the package as it was put (still encrypted under the user's passphrase), and its generation. To the unsigned cable in Normal only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package",
    "generation"
  ],
  "properties": {
    "package": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1024,
      "description": "base64 of 1 to 768 bytes"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    }
  }
}
