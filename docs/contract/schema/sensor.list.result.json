{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-firmware/docs/contract/schema/sensor.list.result.json",
  "title": "Result of sensor.list: one CLI page of the board's sensor settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total",
    "settings",
    "next"
  ],
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "next": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  }
}
